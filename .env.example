# Copy to .env and fill in. `npm start` and `npm run admin` read it. Never commit .env.

# MongoDB connection string for the travel user (docs/mongodb-setup.md). The database is the one in the path.
TRAVEL_MONGO_URL=mongodb://travel:CHANGE_ME@127.0.0.1:27017/highwatch_travel?authSource=highwatch_travel

# The owner's token for the /v1 admin API. Make one with: npm run admin -- token
TRAVEL_ADMIN_TOKEN=

# Where the API listens. Keep 127.0.0.1 and put a reverse proxy with HTTPS in front (README, "Reach it from your
# game servers"). Use 0.0.0.0 only on a private network you trust.
TRAVEL_HOST=127.0.0.1
TRAVEL_PORT=6070

# 1 when a reverse proxy sits in front, so the failed-key limiter sees the real client address.
TRAVEL_TRUST_PROXY=0

# The web console at /console/ (docs/console.md). On unless 0. It binds where the API binds.
TRAVEL_CONSOLE=1
